# Copy to .env and fill in. .env is gitignored — never commit it.
#
# Generate a password with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Both docker-compose.yml and the backend read this file, so the password
# lives in exactly one place. Changing POSTGRES_USER/PASSWORD/DB after the
# database volume exists has no effect — Postgres only reads them when it
# initialises an empty data directory. Recreate the volume to apply changes:
#   docker compose down -v && docker compose up -d db

POSTGRES_USER=budgeter
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=budgeter

# Where the backend reaches the database. Defaults suit the Docker container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Plaid (linked bank accounts) ---------------------------------------
# Optional. Without these the Linked screen says it is not configured and
# every other screen carries on as before.
#
# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Encrypts Plaid access tokens before they are stored. A Plaid access token is
# a long-lived read key to a real bank account, and this database gets dumped
# and copied around like ordinary data. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Changing it makes every already-linked bank undecryptable — relink, or keep
# the old key.
PLAID_TOKEN_KEY=

# --- Login ----------------------------------------------------------------
# Signs the session cookie. No default on purpose: a fallback signing key is a
# key an attacker already has, and forging a session with it skips the login
# entirely. Changing it signs you out, and nothing else. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Demand a TOTP code at sign-in as well as the password. Off by default: this
# app answers on loopback with one user, and an attacker who has the password
# but not the phone is already typing on this machine — where they could read
# the database directly. What the code reliably did instead was stand between
# the owner and their own budget, twice. Turn it on if this ever leaves
# loopback; a passkey is the better answer either way.
# REQUIRE_TOTP=true

SESSION_SECRET=

# --- Sign-in ------------------------------------------------------------
# Demand a six-digit code as well as the password. Off by default: this app is
# one user on loopback, and someone who has the password but not the code has
# to already be typing on the machine that holds the database. Register a
# passkey instead — Touch ID is one gesture, is multi-factor on its own, and is
# less friction than typing a password at all.
# Turn this on if the app ever leaves loopback or gains a second user.
# REQUIRE_TOTP=true
